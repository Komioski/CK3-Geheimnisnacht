pdxmesh = {
	name = "female_hair_ethiopian_03_mesh"
	file = "f_hair_ethiopian_03.mesh"

	meshsettings = {
		name = "female_hair_ethiopian_03Shape"
		index = 0
		texture_diffuse = "f_hair_ethiopian_03_diffuse.dds"
		texture_normal = "f_hair_ethiopian_03_normal.dds"
		texture_specular = "f_hair_ethiopian_03_properties.dds"
		texture = { file = "black_ssao_color.dds" index = 3 }			
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

